# RIS-Timing API Configuration
EXPO_PUBLIC_API_URL=https://api.ris-timing.be/live/v2/

# Your RIS-Timing UUID
EXPO_PUBLIC_UUID=your-uuid-here

# Telemetry update interval in milliseconds
EXPO_PUBLIC_UPDATE_INTERVAL=3000

# Bluetooth connection timeout in milliseconds
EXPO_PUBLIC_BLE_TIMEOUT=3000

# Maximum retries for BLE connection
EXPO_PUBLIC_BLE_RETRIES=5
