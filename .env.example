# RIS-Timing API Configuration
REACT_APP_API_URL=https://api.ris-timing.be/live/v2/

# Your RIS-Timing UUID (obtenu depuis live.ris-timing.be)
REACT_APP_UUID=your-uuid-here

# Default car number to track
REACT_APP_CAR_NUMBER=0

# Telemetry update interval in milliseconds
REACT_APP_UPDATE_INTERVAL=5000

# Bluetooth connection timeout in milliseconds
REACT_APP_BLE_TIMEOUT=10000

# Maximum retries for BLE connection
REACT_APP_BLE_RETRIES=5
