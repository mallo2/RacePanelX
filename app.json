{
  "expo": {
    "name": "RacePanelX",
    "slug": "racepanelx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "racepanelx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "be.malloryBouchard.RacePanelX",
      "infoPlist": {
        "NSBluetoothCentralUsageDescription": "This app needs access to Bluetooth to scan for and connect to CoolLedX LED panels.",
        "NSBluetoothAlwaysUsageDescription": "This app needs access to Bluetooth to scan for and connect to CoolLedX LED panels even when the app is in background.",
        "NSLocationWhenInUseUsageDescription": "This app needs location access to scan for Bluetooth devices."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1026",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "be.malloryBouchard.RacePanelX"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1026",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "This app needs access to Bluetooth to scan for and connect to CoolLedX LED panels even when the app is in background."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}